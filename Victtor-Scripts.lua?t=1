local function playSound(id, vol)
    if not Config.soundEnabled then return end
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. id
        s.Volume = vol or 0.3
        s.Parent = SoundService
        s:Play()
        Debris:AddItem(s, 5)
    end)
end

